            <div class="ai-product-info-tabs__spec-value-{{ ai_gen_id }}">{{ block.settings.spec_2_value }}</div>
          </div>
        {% endif %}
        
        {% if block.settings.spec_3_label != blank and block.settings.spec_3_value != blank %}
          <div class="ai-product-info-tabs__spec-row-{{ ai_gen_id }}">
            <div class="ai-product-info-tabs__spec-label-{{ ai_gen_id }}">{{ block.settings.spec_3_label }}</div>
            <div class="ai-product-info-tabs__spec-value-{{ ai_gen_id }}">{{ block.settings.spec_3_value }}</div>
          </div>
        {% endif %}
        
        {% if block.settings.spec_4_label != blank and block.settings.spec_4_value != blank %}
          <div class="ai-product-info-tabs__spec-row-{{ ai_gen_id }}">
            <div class="ai-product-info-tabs__spec-label-{{ ai_gen_id }}">{{ block.settings.spec_4_label }}</div>
            <div class="ai-product-info-tabs__spec-value-{{ ai_gen_id }}">{{ block.settings.spec_4_value }}</div>
          </div>
        {% endif %}
        
        {% if block.settings.spec_5_label != blank and block.settings.spec_5_value != blank %}
          <div class="ai-product-info-tabs__spec-row-{{ ai_gen_id }}">
            <div class="ai-product-info-tabs__spec-label-{{ ai_gen_id }}">{{ block.settings.spec_5_label }}</div>
            <div class="ai-product-info-tabs__spec-value-{{ ai_gen_id }}">{{ block.settings.spec_5_value }}</div>
