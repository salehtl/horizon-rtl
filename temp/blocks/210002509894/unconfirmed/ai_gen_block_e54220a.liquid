{% doc %}
  @prompt
    i want a description box and package box and specification box, i don't want it like this i want something like Description Specifications Package List and under each category i want to add the information's and i want them to be one line side by side   
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-info-tabs-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-product-info-tabs__nav-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.tab_gap }}px;
    border-bottom: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    margin-bottom: {{ block.settings.content_spacing }}px;
  }

  .ai-product-info-tabs__tab-{{ ai_gen_id }} {
    flex: 1;
    padding: {{ block.settings.tab_padding }}px;
    background: none;
    border: none;
    border-bottom: 3px solid transparent;
    cursor: pointer;
    font-size: {{ block.settings.tab_font_size }}px;
    font-weight: 600;
    color: {{ block.settings.tab_color }};
    transition: all 0.3s ease;
    text-align: center;
  }

  .ai-product-info-tabs__tab-{{ ai_gen_id }}:hover {
    color: {{ block.settings.tab_hover_color }};
    background-color: {{ block.settings.tab_hover_background }};
  }

  .ai-product-info-tabs__tab-{{ ai_gen_id }}.active {
    color: {{ block.settings.tab_active_color }};
    border-bottom-color: {{ block.settings.tab_active_border }};
  }

  .ai-product-info-tabs__content-{{ ai_gen_id }} {
    padding: {{ block.settings.content_padding }}px;
    background-color: {{ block.settings.content_background }};
    border-radius: {{ block.settings.border_radius }}px;
    {% if block.settings.show_content_border %}
      border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    {% endif %}
  }

  .ai-product-info-tabs__panel-{{ ai_gen_id }} {
    display: none;
  }

  .ai-product-info-tabs__panel-{{ ai_gen_id }}.active {
    display: block;
  }

  .ai-product-info-tabs__description-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.6;
  }

  .ai-product-info-tabs__description-{{ ai_gen_id }} p {
    margin: 0 0 16px 0;
  }

  .ai-product-info-tabs__description-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-product-info-tabs__spec-table-{{ ai_gen_id }} {
    width: 100%;
  }

  .ai-product-info-tabs__spec-row-{{ ai_gen_id }} {
    display: flex;
    align-items: stretch;
    border-bottom: 1px solid {{ block.settings.divider_color }};
  }

  .ai-product-info-tabs__spec-row-{{ ai_gen_id }}:last-child {
    border-bottom: none;
  }

  .ai-product-info-tabs__spec-label-{{ ai_gen_id }} {
    flex: 0 0 40%;
    padding: {{ block.settings.row_padding }}px;
    color: {{ block.settings.label_color }};
    font-size: {{ block.settings.text_size }}px;
    font-weight: 600;
    background-color: {{ block.settings.label_background }};
  }

  .ai-product-info-tabs__spec-value-{{ ai_gen_id }} {
    flex: 1;
    padding: {{ block.settings.row_padding }}px;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
  }

  .ai-product-info-tabs__package-list-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .ai-product-info-tabs__package-item-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: {{ block.settings.row_padding }}px 0;
    border-bottom: 1px solid {{ block.settings.divider_color }};
  }

  .ai-product-info-tabs__package-item-{{ ai_gen_id }}:last-child {
    border-bottom: none;
  }

  .ai-product-info-tabs__package-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ block.settings.icon_background }};
    border-radius: 50%;
    color: {{ block.settings.icon_color }};
  }

  .ai-product-info-tabs__package-icon-{{ ai_gen_id }} svg {
    width: 12px;
    height: 12px;
  }

  .ai-product-info-tabs__package-text-{{ ai_gen_id }} {
    flex: 1;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-product-info-tabs-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-product-info-tabs__nav-{{ ai_gen_id }} {
      gap: {{ block.settings.tab_gap | times: 0.5 }}px;
    }

    .ai-product-info-tabs__tab-{{ ai_gen_id }} {
      padding: {{ block.settings.tab_padding | times: 0.75 }}px;
      font-size: {{ block.settings.tab_font_size | times: 0.85 }}px;
    }

    .ai-product-info-tabs__content-{{ ai_gen_id }} {
      padding: {{ block.settings.content_padding | times: 0.75 }}px;
    }

    .ai-product-info-tabs__spec-row-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-product-info-tabs__spec-label-{{ ai_gen_id }} {
      border-bottom: 1px solid {{ block.settings.divider_color }};
    }
  }
{% endstyle %}

<product-info-tabs-{{ ai_gen_id }} class="ai-product-info-tabs-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-product-info-tabs__nav-{{ ai_gen_id }}">
