      <div class="ai-product-info-tabs__description-{{ ai_gen_id }}">
        {{ block.settings.description }}
      </div>
    </div>

    <div class="ai-product-info-tabs__panel-{{ ai_gen_id }}" data-panel="specifications">
      <div class="ai-product-info-tabs__spec-table-{{ ai_gen_id }}">
        {% if block.settings.spec_1_label != blank and block.settings.spec_1_value != blank %}
          <div class="ai-product-info-tabs__spec-row-{{ ai_gen_id }}">
