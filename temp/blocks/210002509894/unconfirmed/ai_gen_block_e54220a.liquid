              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </div>
            <div class="ai-product-info-tabs__package-text-{{ ai_gen_id }}">{{ block.settings.package_2 }}</div>
          </li>
        {% endif %}
        
        {% if block.settings.package_3 != blank %}
          <li class="ai-product-info-tabs__package-item-{{ ai_gen_id }}">
            <div class="ai-product-info-tabs__package-icon-{{ ai_gen_id }}">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </div>
            <div class="ai-product-info-tabs__package-text-{{ ai_gen_id }}">{{ block.settings.package_3 }}</div>
          </li>
        {% endif %}
        
        {% if block.settings.package_4 != blank %}
          <li class="ai-product-info-tabs__package-item-{{ ai_gen_id }}">
            <div class="ai-product-info-tabs__package-icon-{{ ai_gen_id }}">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </div>
            <div class="ai-product-info-tabs__package-text-{{ ai_gen_id }}">{{ block.settings.package_4 }}</div>
          </li>
        {% endif %}
        
        {% if block.settings.package_5 != blank %}
          <li class="ai-product-info-tabs__package-item-{{ ai_gen_id }}">
            <div class="ai-product-info-tabs__package-icon-{{ ai_gen_id }}">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </div>
