      class="ai-product-info-tabs__tab-{{ ai_gen_id }} active" 
      data-tab="description"
      aria-label="Description tab"
    >
      {{ block.settings.tab_1_title }}
    </button>
    <button 
      class="ai-product-info-tabs__tab-{{ ai_gen_id }}" 
      data-tab="specifications"
      aria-label="Specifications tab"
    >
      {{ block.settings.tab_2_title }}
    </button>
    <button 
      class="ai-product-info-tabs__tab-{{ ai_gen_id }}" 
      data-tab="package"
      aria-label="Package list tab"
    >
      {{ block.settings.tab_3_title }}
    </button>
  </div>

  <div class="ai-product-info-tabs__content-{{ ai_gen_id }}">
