{% doc %}
  @prompt
    i want a description box and package box and specification box
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-spec-box-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    {% if block.settings.show_border %}
      border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    {% endif %}
  }

  .ai-spec-box__title-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.title_spacing }}px 0;
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_size }}px;
    font-weight: 700;
  }

  .ai-spec-box__table-{{ ai_gen_id }} {
    width: 100%;
    border-collapse: collapse;
  }

  .ai-spec-box__row-{{ ai_gen_id }} {
    display: flex;
    align-items: stretch;
    border-bottom: 1px solid {{ block.settings.divider_color }};
  }

  .ai-spec-box__row-{{ ai_gen_id }}:last-child {
    border-bottom: none;
  }

  .ai-spec-box__label-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.label_width }}%;
    padding: {{ block.settings.row_padding }}px;
    color: {{ block.settings.label_color }};
    font-size: {{ block.settings.text_size }}px;
    font-weight: 600;
    background-color: {{ block.settings.label_background }};
  }

  .ai-spec-box__value-{{ ai_gen_id }} {
    flex: 1;
    padding: {{ block.settings.row_padding }}px;
    color: {{ block.settings.value_color }};
    font-size: {{ block.settings.text_size }}px;
    background-color: {{ block.settings.value_background }};
  }

  @media screen and (max-width: 749px) {
    .ai-spec-box-{{ ai_gen_id }} {
      width: 100%;
      padding: {{ block.settings.padding | times: 0.75 }}px;
    }

    .ai-spec-box__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.85 }}px;
    }

    .ai-spec-box__label-{{ ai_gen_id }},
    .ai-spec-box__value-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
      padding: {{ block.settings.row_padding | times: 0.75 }}px;
    }

    {% if block.settings.mobile_stack %}
      .ai-spec-box__row-{{ ai_gen_id }} {
        flex-direction: column;
      }

      .ai-spec-box__label-{{ ai_gen_id }} {
        flex: 1;
        border-bottom: 1px solid {{ block.settings.divider_color }};
      }
    {% endif %}
  }
{% endstyle %}

<div class="ai-spec-box-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.title != blank %}
    <h3 class="ai-spec-box__title-{{ ai_gen_id }}">{{ block.settings.title }}</h3>
  {% endif %}
  
  <div class="ai-spec-box__table-{{ ai_gen_id }}">
    {% if block.settings.spec_1_label != blank and block.settings.spec_1_value != blank %}
      <div class="ai-spec-box__row-{{ ai_gen_id }}">
        <div class="ai-spec-box__label-{{ ai_gen_id }}">{{ block.settings.spec_1_label }}</div>
        <div class="ai-spec-box__value-{{ ai_gen_id }}">{{ block.settings.spec_1_value }}</div>
      </div>
    {% endif %}
    
    {% if block.settings.spec_2_label != blank and block.settings.spec_2_value != blank %}
      <div class="ai-spec-box__row-{{ ai_gen_id }}">
        <div class="ai-spec-box__label-{{ ai_gen_id }}">{{ block.settings.spec_2_label }}</div>
        <div class="ai-spec-box__value-{{ ai_gen_id }}">{{ block.settings.spec_2_value }}</div>
      </div>
    {% endif %}
    
    {% if block.settings.spec_3_label != blank and block.settings.spec_3_value != blank %}
      <div class="ai-spec-box__row-{{ ai_gen_id }}">
        <div class="ai-spec-box__label-{{ ai_gen_id }}">{{ block.settings.spec_3_label }}</div>
        <div class="ai-spec-box__value-{{ ai_gen_id }}">{{ block.settings.spec_3_value }}</div>
      </div>
    {% endif %}
    
    {% if block.settings.spec_4_label != blank and block.settings.spec_4_value != blank %}
      <div class="ai-spec-box__row-{{ ai_gen_id }}">
        <div class="ai-spec-box__label-{{ ai_gen_id }}">{{ block.settings.spec_4_label }}</div>
        <div class="ai-spec-box__value-{{ ai_gen_id }}">{{ block.settings.spec_4_value }}</div>
      </div>
    {% endif %}
    
    {% if block.settings.spec_5_label != blank and block.settings.spec_5_value != blank %}
      <div class="ai-spec-box__row-{{ ai_gen_id }}">
        <div class="ai-spec-box__label-{{ ai_gen_id }}">{{ block.settings.spec_5_label }}</div>
        <div class="ai-spec-box__value-{{ ai_gen_id }}">{{ block.settings.spec_5_value }}</div>
      </div>
    {% endif %}
    
    {% if block.settings.spec_6_label != blank and block.settings.spec_6_value != blank %}
      <div class="ai-spec-box__row-{{ ai_gen_id }}">
        <div class="ai-spec-box__label-{{ ai_gen_id }}">{{ block.settings.spec_6_label }}</div>
        <div class="ai-spec-box__value-{{ ai_gen_id }}">{{ block.settings.spec_6_value }}</div>
      </div>
    {% endif %}
    
    {% if block.settings.spec_7_label != blank and block.settings.spec_7_value != blank %}
      <div class="ai-spec-box__row-{{ ai_gen_id }}">
        <div class="ai-spec-box__label-{{ ai_gen_id }}">{{ block.settings.spec_7_label }}</div>
        <div class="ai-spec-box__value-{{ ai_gen_id }}">{{ block.settings.spec_7_value }}</div>
      </div>
    {% endif %}
    
    {% if block.settings.spec_8_label != blank and block.settings.spec_8_value != blank %}
      <div class="ai-spec-box__row-{{ ai_gen_id }}">
        <div class="ai-spec-box__label-{{ ai_gen_id }}">{{ block.settings.spec_8_label }}</div>
        <div class="ai-spec-box__value-{{ ai_gen_id }}">{{ block.settings.spec_8_value }}</div>
      </div>
    {% endif %}
  </div>
</div>

